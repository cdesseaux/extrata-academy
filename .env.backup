# ============================================
# EXTRATA ACADEMY - Environment Variables
# ============================================
# Copy this file to .env and update with your values
# ============================================

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
BUILD_TARGET=development

# ============================================
# PORTS
# ============================================
BACKEND_PORT=4000
BACKEND_DEBUG_PORT=9229
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8080
ADMINER_PORT=8081
REDIS_INSIGHT_PORT=8082

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_NAME=academy
DB_USER=academy
DB_PASSWORD=academy123
DB_SYNC=false
DB_LOGGING=true

# ============================================
# REDIS CACHE
# ============================================
REDIS_PASSWORD=redis123

# ============================================
# KEYCLOAK (Authentication)
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_REALM=extrata
KEYCLOAK_CLIENT_ID=academy-backend
KEYCLOAK_CLIENT_SECRET=

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# AWS (S3 Storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=academy-assets-dev

# ============================================
# STORAGE (Local Fallback)
# ============================================
STORAGE_TYPE=local
STORAGE_PATH=/app/storage

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@academy.extrata.gov.br

# ============================================
# URLs
# ============================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080

# ============================================
# FRONTEND PUBLIC VARS (Accessible from browser)
# ============================================
NEXT_PUBLIC_KEYCLOAK_REALM=extrata
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=academy-frontend

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_ANALYTICS=false
ENABLE_COMMUNITY=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_COMMUNITY=false

# ============================================
# MONITORING & LOGGING
# ============================================
# Sentry Error Tracking
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_RELEASE=extrata-academy@1.0.0
# Frontend Sentry (NEXT_PUBLIC_ vars are accessible from browser)
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=debug

# ============================================
# DOCKER COMMANDS (Optional Override)
# ============================================
BACKEND_COMMAND=npm run start:dev
FRONTEND_COMMAND=npm run dev

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# Uncomment and update for production

# NODE_ENV=production
# BUILD_TARGET=production
# DB_SYNC=false
# DB_LOGGING=false
# STORAGE_TYPE=s3
# BACKEND_COMMAND=node dist/main.js
# FRONTEND_COMMAND=node server.js

