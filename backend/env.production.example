# Configurações de Produção - Extrata Academy
NODE_ENV=production
PORT=4000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=academy
DB_PASSWORD=academy123
DB_DATABASE=academy

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak
KEYCLOAK_URL=https://keycloak-hlg.extrata.com.br
KEYCLOAK_REALM=extrata
KEYCLOAK_CLIENT_ID=extrata-academy

# Logging
LOG_LEVEL=info

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
BCRYPT_ROUNDS=12

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cache
CACHE_TTL=300
CACHE_MAX=1000


